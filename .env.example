# Mã OAuth Web client từ Google Cloud Console.
# Authorized JavaScript origins phải có đúng URL trang (ví dụ http://localhost:47221).
GOOGLE_CLIENT_ID=

# Chuỗi bí mật ký cookie phiên. Đặt một chuỗi dài, ngẫu nhiên khi triển khai.
SESSION_SECRET=

# Cổng HTTP. Mặc định 47221.
PORT=47221

# Thư mục file SQLite. Mặc định ./data
DATA_DIR=./data

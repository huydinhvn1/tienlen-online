# Mã OAuth Web client từ Google Cloud Console.
# Authorized JavaScript origins phải có đúng URL trang (ví dụ http://localhost:47221).
GOOGLE_CLIENT_ID=

# Chuỗi bí mật ký cookie phiên. Đặt một chuỗi dài, ngẫu nhiên khi triển khai.
SESSION_SECRET=

# Cổng HTTP. Mặc định 47221.
PORT=47221

# Thư mục file SQLite. Mặc định ./data
DATA_DIR=./data

# Đường dẫn Vite khi gắn vào thư mục con (vd /tienlen/). Mặc định /.
VITE_BASE_PATH=/

# Origin máy chủ API/Socket.IO khi giao diện nằm ở domain khác (vd https://tienlen-api.huydinh.app).
# Để trống thì gọi cùng origin.
VITE_API_URL=

# Thêm origin CORS, phân tách bằng dấu phẩy. Các origin mặc định đã gồm huydinh.app và trang Render.
# CORS_ORIGINS=
